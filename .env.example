PORT=8080
# Optional fallback AIS key for a private/single-user deployment.
# Public PWA users can instead supply their own key in Settings.
AISSTREAM_API_KEY=

# For a public backend, restrict this to your GitHub Pages origin, e.g.
# ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
# Multiple origins can be comma-separated.
ALLOWED_ORIGINS=*
